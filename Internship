                <div>
                    <h1 class="font-bold text-base leading-tight tracking-wide text-slate-100">Thai TA in Vietnam</h1>
                    <p class="text-xs text-amber-400 font-medium">🇻🇳 ระบบผู้ช่วยสอนภาษาไทย</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1.5">
                <button onclick="switchTab('students')" id="tab-btn-students" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium text-left">
                    <i class="fa-solid fa-user-graduate text-emerald-400 text-lg w-6 text-center"></i>
                    <span>นักเรียน & ความคืบหน้า</span>
                    <span id="badge-students" class="ml-auto bg-emerald-500/20 text-emerald-300 text-xs px-2 py-0.5 rounded-full border border-emerald-500/30">0</span>
                </button>

                <button onclick="switchTab('teachers')" id="tab-btn-teachers" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium text-left">
                    <i class="fa-solid fa-user-tie text-purple-400 text-lg w-6 text-center"></i>
                    <span>อาจารย์ & บุคลากร</span>
                    <span id="badge-teachers" class="ml-auto bg-purple-500/20 text-purple-300 text-xs px-2 py-0.5 rounded-full border border-purple-500/30">0</span>
                </button>

                <button onclick="switchTab('tasks')" id="tab-btn-tasks" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium text-left">
                    <i class="fa-solid fa-list-check text-sky-400 text-lg w-6 text-center"></i>
                    <span>ภารกิจผู้ช่วยสอน</span>
                    <span id="badge-tasks" class="ml-auto bg-sky-500/20 text-sky-300 text-xs px-2 py-0.5 rounded-full border border-sky-500/30">0</span>
                </button>

                <button onclick="switchTab('journal')" id="tab-btn-journal" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium text-left">
                    <i class="fa-solid fa-book-bookmark text-amber-400 text-lg w-6 text-center"></i>
                    <span>ไดอารี่ & คำศัพท์เวียดนาม</span>
                    <span id="badge-journal" class="ml-auto bg-amber-500/20 text-amber-300 text-xs px-2 py-0.5 rounded-full border border-amber-500/30">0</span>
                </button>
            </nav>
        </div>

        <div class="p-4 border-t border-slate-800 text-xs text-slate-400 text-center">
            <p class="flex items-center justify-center gap-1.5"><i class="fa-solid fa-shield-halved text-emerald-400"></i> LocalStorage Auto Saved</p>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-y-auto">
        <!-- Top Navbar -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 sticky top-0 z-10 shadow-sm">
            <div>
                <h2 id="page-title" class="text-xl font-bold text-slate-800 flex items-center gap-2"></h2>
                <p id="page-subtitle" class="text-xs text-slate-500 mt-0.5"></p>
            </div>
            
            <button id="action-add-btn" onclick="openModal()" class="flex items-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-medium px-4 py-2.5 rounded-xl shadow-sm hover:shadow transition-all text-sm">
                <i class="fa-solid fa-plus"></i>
                <span id="action-add-btn-text">เพิ่มข้อมูล</span>
            </button>
        </header>

        <!-- Body Content -->
        <div class="p-4 sm:p-6 lg:p-8 flex-1">
            
            <!-- SECTION 1: STUDENTS -->
            <section id="section-students" class="space-y-6 hidden">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="relative w-full sm:w-80">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="student-search-input" oninput="renderStudents()" placeholder="ค้นหานักเรียน (ชื่อไทย, ชื่อเวียดนาม, ห้อง)..." class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500">
                    </div>
                    <div class="text-xs font-medium text-slate-500">
                        รวมทั้งหมด: <strong id="student-total-count" class="text-emerald-600 font-bold">0</strong> คน
                    </div>
                </div>

                <div id="students-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                <div id="students-empty-state" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
                    <i class="fa-solid fa-user-graduate text-slate-300 text-4xl mb-3"></i>
                    <h3 class="text-slate-700 font-semibold">ยังไม่มีข้อมูลนักเรียน</h3>
                    <p class="text-slate-400 text-sm mt-1 mb-4">คลิกปุ่มเพิ่มข้อมูลนักเรียนเพื่อเริ่มบันทึก</p>
                </div>
            </section>

            <!-- SECTION 2: TEACHERS -->
            <section id="section-teachers" class="space-y-6 hidden">
                <div id="teachers-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                <div id="teachers-empty-state" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
                    <i class="fa-solid fa-user-tie text-slate-300 text-4xl mb-3"></i>
                    <h3 class="text-slate-700 font-semibold">ยังไม่มีข้อมูลอาจารย์</h3>
                    <p class="text-slate-400 text-sm mt-1">บันทึกข้อมูลอาจารย์พี่เลี้ยง หรืออาจารย์ชาวเวียดนามได้ที่นี่</p>
                </div>
            </section>

            <!-- SECTION 3: TASKS -->
            <section id="section-tasks" class="space-y-6 hidden">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-center gap-4">
                    <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl w-full md:w-auto overflow-x-auto">
                        <button onclick="setTaskFilter('all')" id="filter-task-all" class="px-3 py-1.5 rounded-lg text-xs font-medium">ทั้งหมด</button>
                        <button onclick="setTaskFilter('todo')" id="filter-task-todo" class="px-3 py-1.5 rounded-lg text-xs font-medium">ยังไม่ได้ทำ</button>
                        <button onclick="setTaskFilter('doing')" id="filter-task-doing" class="px-3 py-1.5 rounded-lg text-xs font-medium">กำลังทำ</button>
                        <button onclick="setTaskFilter('done')" id="filter-task-done" class="px-3 py-1.5 rounded-lg text-xs font-medium">เสร็จแล้ว</button>
                    </div>
                </div>
                <div id="tasks-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                <div id="tasks-empty-state" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
                    <i class="fa-solid fa-list-check text-slate-300 text-4xl mb-3"></i>
                    <h3 class="text-slate-700 font-semibold">ไม่มีภารกิจผู้ช่วยสอน</h3>
                </div>
            </section>

            <!-- SECTION 4: JOURNAL -->
            <section id="section-journal" class="space-y-6 hidden">
                <div id="journal-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                <div id="journal-empty-state" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
                    <i class="fa-solid fa-book-bookmark text-slate-300 text-4xl mb-3"></i>
                    <h3 class="text-slate-700 font-semibold">ยังไม่มีบันทึกไดอารี่/คำศัพท์</h3>
                </div>
            </section>

        </div>
    </main>

    <!-- UNIVERSAL DYNAMIC MODAL -->
    <div id="item-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <h3 id="modal-title" class="font-bold text-slate-800 text-base"></h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 w-8 h-8 rounded-full flex items-center justify-center hover:bg-slate-200 transition-all">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="modal-form" onsubmit="handleFormSubmit(event)" class="p-6 overflow-y-auto space-y-4">
                <input type="hidden" id="form-id">
                
                <!-- Dynamic Fields Injection -->
                <div id="modal-dynamic-fields" class="space-y-4"></div>

                <div class="pt-3 flex justify-end gap-3 border-t border-slate-100">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-100 transition-all">ยกเลิก</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-medium shadow-sm transition-all">บันทึกข้อมูล</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        let currentTab = 'students';
        let currentTaskFilter = 'all';

        // Initial Data Structures
        let students = JSON.parse(localStorage.getItem('vn_ta_students')) || [
            { id: 's1', thaiName: 'สมชาย ใจดี', vnName: 'Nguyễn Văn A (เหวียน วาน เอ)', classGroup: 'ภาษาไทย 101 - ห้อง A', speakingSkill: 3, listeningSkill: 4, readingSkill: 3, writingSkill: 2, strengths: 'จำคำศัพท์เก่ง ออกเสียง ร/ล ชัดเจน', improvements: 'ผันวรรณยุกต์เสียงเอก-โท ยังสับสน', createdAt: new Date().toISOString() }
        ];

        let teachers = JSON.parse(localStorage.getItem('vn_ta_teachers')) || [
            { id: 't1', name: 'Cô Linh (อาจารย์ ลินห์)', role: 'อาจารย์พี่เลี้ยงประจำภาควิชา', subjects: 'ไวยากรณ์ไทยขั้นสูง', contact: 'Zalo: 0912345678 / Email: linh@univ.edu.vn', notes: 'อาจารย์เน้นย้ำเรื่องการตรวจการบ้านเรื่องการเขียนเรียงความส่งทุกวันศุกร์', createdAt: new Date().toISOString() }
        ];

        let tasks = JSON.parse(localStorage.getItem('vn_ta_tasks')) || [
            { id: 'tk1', title: 'เตรียมใบงานบทที่ 3 (วรรณยุกต์ไทย)', desc: 'พิมพ์ชีทคำศัพท์พร้อมคำแปลภาษาเวียดนาม 30 ชุด', dueDate: '2026-11-25', priority: 'High', status: 'doing', createdAt: new Date().toISOString() }
        ];

        let journal = JSON.parse(localStorage.getItem('vn_ta_journal')) || [
            { id: 'j1', title: 'คำศัพท์เวียดนามใช้บ่อยในห้องเรียน', category: 'คำศัพท์', content: 'Cảm ơn = ขอบคุณ\nXin chào = สวัสดี\nHiểu không? = เข้าใจไหม?\nBắt đầu = เริ่มต้น', createdAt: new Date().toISOString() }
        ];

        window.onload = function() {
            switchTab('students');
            saveData();
        };

        function saveData() {
            localStorage.setItem('vn_ta_students', JSON.stringify(students));
            localStorage.setItem('vn_ta_teachers', JSON.stringify(teachers));
            localStorage.setItem('vn_ta_tasks', JSON.stringify(tasks));
            localStorage.setItem('vn_ta_journal', JSON.stringify(journal));
            updateBadges();
        }

        function updateBadges() {
            document.getElementById('badge-students').textContent = students.length;
            document.getElementById('badge-teachers').textContent = teachers.length;
            document.getElementById('badge-tasks').textContent = tasks.filter(t => t.status !== 'done').length;
            document.getElementById('badge-journal').textContent = journal.length;
        }

        function switchTab(tab) {
            currentTab = tab;
            const titleEl = document.getElementById('page-title');
            const subtitleEl = document.getElementById('page-subtitle');
            const addBtnText = document.getElementById('action-add-btn-text');

            ['students', 'teachers', 'tasks', 'journal'].forEach(t => {
                const sec = document.getElementById(`section-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
                if (t === tab) {
                    sec.classList.remove('hidden');
                    btn.className = 'w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-slate-800 text-white font-medium text-left shadow-sm';
                } else {
                    sec.classList.add('hidden');
                    btn.className = 'w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800/60 hover:text-slate-200 transition-all font-medium text-left';
                }
            });

            if (tab === 'students') {
                titleEl.innerHTML = '<i class="fa-solid fa-user-graduate text-emerald-600"></i> ข้อมูลนักเรียน & ประเมินทักษะ';
                subtitleEl.textContent = 'บันทึกรายชื่อนักเรียน ระดับคลาสเรียน และพัฒนาการเรียนภาษาไทย';
                addBtnText.textContent = 'เพิ่มนักเรียนใหม่';
                renderStudents();
            } else if (tab === 'teachers') {
                titleEl.innerHTML = '<i class="fa-solid fa-user-tie text-purple-600"></i> ข้อมูลอาจารย์ & บุคลากร';
                subtitleEl.textContent = 'บันทึกช่องทางติดต่ออาจารย์พี่เลี้ยง และคำแนะนำ/ข้อสั่งการ';
                addBtnText.textContent = 'เพิ่มอาจารย์';
                renderTeachers();
            } else if (tab === 'tasks') {
                titleEl.innerHTML = '<i class="fa-solid fa-list-check text-sky-600"></i> ภารกิจ & งานผู้ช่วยสอน';
                subtitleEl.textContent = 'ติดตามงานเตรียมชีท ตรวจการบ้าน คุมสอบ และภารกิจประจำวัน';
                addBtnText.textContent = 'เพิ่มภารกิจงาน';
                renderTasks();
            } else if (tab === 'journal') {
                titleEl.innerHTML = '<i class="fa-solid fa-book-bookmark text-amber-600"></i> ไดอารี่ & คลังศัพท์เวียดนาม';
                subtitleEl.textContent = 'บันทึกเรื่องราวการฝึกงาน เกร็ดวัฒนธรรม และคำศัพท์เวียดนาม';
                addBtnText.textContent = 'เพิ่มบันทึกใหม่';
                renderJournal();
            }
        }

        // --- STUDENTS RENDER --- //
        function renderStudents() {
            const container = document.getElementById('students-list-container');
            const empty = document.getElementById('students-empty-state');
            const keyword = document.getElementById('student-search-input').value.toLowerCase();
            container.innerHTML = '';

            const filtered = students.filter(s => 
                s.thaiName.toLowerCase().includes(keyword) || 
                s.vnName.toLowerCase().includes(keyword) || 
                (s.classGroup && s.classGroup.toLowerCase().includes(keyword))
            );

            document.getElementById('student-total-count').textContent = filtered.length;

            if (filtered.length === 0) { empty.classList.remove('hidden'); return; }
            empty.classList.add('hidden');

            filtered.forEach(s => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between';
                card.innerHTML = `
                    <div>
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div>
                                <h4 class="font-bold text-slate-800 text-base">${escapeHtml(s.thaiName)}</h4>
                                <p class="text-xs text-emerald-600 font-medium"><i class="fa-solid fa-language mr-1"></i>${escapeHtml(s.vnName || '-')}</p>
                            </div>
                            <div class="flex gap-1">
                                <button onclick="openModal('${s.id}')" class="text-slate-400 hover:text-sky-600 p-1.5 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button onclick="deleteStudent('${s.id}')" class="text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>

                        <div class="my-3 inline-block px-2.5 py-1 bg-slate-100 text-slate-600 text-xs rounded-lg font-medium">
                            <i class="fa-solid fa-chalkboard mr-1"></i>${escapeHtml(s.classGroup || 'ไม่ระบุห้อง')}
                        </div>

                        <!-- Skill Ratings -->
                        <div class="space-y-1.5 my-3 bg-slate-50 p-3 rounded-xl border border-slate-100 text-xs">
                            <div class="flex justify-between items-center"><span>ฟัง (Listening):</span> ${renderStars(s.listeningSkill)}</div>
                            <div class="flex justify-between items-center"><span>พูด (Speaking):</span> ${renderStars(s.speakingSkill)}</div>
                            <div class="flex justify-between items-center"><span>อ่าน (Reading):</span> ${renderStars(s.readingSkill)}</div>
                            <div class="flex justify-between items-center"><span>เขียน (Writing):</span> ${renderStars(s.writingSkill)}</div>
                        </div>

                        ${s.strengths ? `<p class="text-xs text-slate-600 mb-1"><strong>จุดเด่น:</strong> ${escapeHtml(s.strengths)}</p>` : ''}
                        ${s.improvements ? `<p class="text-xs text-amber-700 bg-amber-50 p-2 rounded-lg border border-amber-100"><strong>ควรปรับปรุง:</strong> ${escapeHtml(s.improvements)}</p>` : ''}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function deleteStudent(id) {
            students = students.filter(s => s.id !== id);
            saveData();
            renderStudents();
        }

        // --- TEACHERS RENDER --- //
        function renderTeachers() {
            const container = document.getElementById('teachers-list-container');
            const empty = document.getElementById('teachers-empty-state');
            container.innerHTML = '';

            if (teachers.length === 0) { empty.classList.remove('hidden'); return; }
            empty.classList.add('hidden');

            teachers.forEach(t => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between';
                card.innerHTML = `
                    <div>
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div>
                                <h4 class="font-bold text-slate-800 text-base">${escapeHtml(t.name)}</h4>
                                <span class="text-xs text-purple-600 font-medium px-2 py-0.5 bg-purple-50 rounded-md border border-purple-100">${escapeHtml(t.role || 'อาจารย์')}</span>
                            </div>
                            <div class="flex gap-1">
                                <button onclick="openModal('${t.id}')" class="text-slate-400 hover:text-purple-600 p-1.5 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button onclick="deleteTeacher('${t.id}')" class="text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>

                        ${t.subjects ? `<p class="text-xs text-slate-500 mt-2"><i class="fa-solid fa-book-open mr-1"></i>วิชา: ${escapeHtml(t.subjects)}</p>` : ''}
                        ${t.contact ? `<p class="text-xs text-slate-600 mt-1.5 bg-slate-50 p-2 rounded-lg"><i class="fa-solid fa-address-book mr-1 text-slate-400"></i>${escapeHtml(t.contact)}</p>` : ''}
                        ${t.notes ? `<div class="mt-3 p-3 bg-amber-50/60 border border-amber-200/60 rounded-xl text-xs text-slate-700"><strong><i class="fa-solid fa-thumbtack text-amber-500 mr-1"></i>โน้ตสั่งการ/คำแนะนำ:</strong><p class="mt-1 leading-relaxed">${escapeHtml(t.notes)}</p></div>` : ''}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function deleteTeacher(id) {
            teachers = teachers.filter(t => t.id !== id);
            saveData();
            renderTeachers();
        }

        // --- TASKS RENDER --- //
        function setTaskFilter(filter) {
            currentTaskFilter = filter;
            ['all', 'todo', 'doing', 'done'].forEach(f => {
                const btn = document.getElementById(`filter-task-${f}`);
                btn.className = f === filter 
                    ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-sky-700 shadow-sm border border-slate-200' 
                    : 'px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600';
            });
            renderTasks();
        }

        function renderTasks() {
            const container = document.getElementById('tasks-list-container');
            const empty = document.getElementById('tasks-empty-state');
            container.innerHTML = '';

            const filtered = tasks.filter(t => currentTaskFilter === 'all' || t.status === currentTaskFilter);

            if (filtered.length === 0) { empty.classList.remove('hidden'); return; }
            empty.classList.add('hidden');

            filtered.forEach(t => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between';
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-2">
                            ${getPriorityBadge(t.priority)}
                            <div class="flex gap-1">
                                <button onclick="openModal('${t.id}')" class="text-slate-400 hover:text-sky-600 p-1 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button onclick="deleteTask('${t.id}')" class="text-slate-400 hover:text-red-600 p-1 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>
                        <h4 class="font-semibold text-slate-800 text-base ${t.status === 'done' ? 'line-through text-slate-400' : ''}">${escapeHtml(t.title)}</h4>
                        <p class="text-slate-500 text-xs mt-1 leading-relaxed">${escapeHtml(t.desc || '-')}</p>
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between mt-4">
                        <span class="text-xs text-slate-400"><i class="fa-regular fa-calendar mr-1"></i>${t.dueDate || 'ไม่ระบุวัน'}</span>
                        <select onchange="updateTaskStatus('${t.id}', this.value)" class="text-xs font-medium border rounded-lg px-2 py-1 bg-slate-50">
                            <option value="todo" ${t.status === 'todo' ? 'selected' : ''}>ยังไม่ได้ทำ</option>
                            <option value="doing" ${t.status === 'doing' ? 'selected' : ''}>กำลังทำ</option>
                            <option value="done" ${t.status === 'done' ? 'selected' : ''}>เสร็จแล้ว</option>
                        </select>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function updateTaskStatus(id, status) {
            const task = tasks.find(t => t.id === id);
            if (task) { task.status = status; saveData(); renderTasks(); }
        }

        function deleteTask(id) {
            tasks = tasks.filter(t => t.id !== id);
            saveData();
            renderTasks();
        }

        // --- JOURNAL RENDER --- //
        function renderJournal() {
            const container = document.getElementById('journal-list-container');
            const empty = document.getElementById('journal-empty-state');
            container.innerHTML = '';

            if (journal.length === 0) { empty.classList.remove('hidden'); return; }
            empty.classList.add('hidden');

            journal.forEach(j => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between';
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-100">${escapeHtml(j.category || 'บันทึก')}</span>
                            <div class="flex gap-1">
                                <button onclick="openModal('${j.id}')" class="text-slate-400 hover:text-amber-600 p-1 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button onclick="deleteJournal('${j.id}')" class="text-slate-400 hover:text-red-600 p-1 rounded-lg hover:bg-slate-100"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>
                        <h4 class="font-bold text-slate-800 text-base mb-2">${escapeHtml(j.title)}</h4>
                        <p class="text-slate-600 text-xs whitespace-pre-line leading-relaxed">${escapeHtml(j.content)}</p>
                    </div>
                    <div class="pt-3 border-t border-slate-100 mt-4 text-[11px] text-slate-400">
                        ${formatDate(j.createdAt)}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function deleteJournal(id) {
            journal = journal.filter(j => j.id !== id);
            saveData();
            renderJournal();
        }

        // --- UNIVERSAL MODAL SYSTEM --- //
