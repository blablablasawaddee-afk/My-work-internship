</head>
<body class="text-slate-700 min-h-screen flex flex-col md:flex-row bg-slate-50">

    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-72 bg-slate-900 text-white flex-shrink-0 flex flex-col justify-between shadow-xl">
        <div>
            <!-- Header Brand -->
            <div class="p-5 border-b border-slate-800 flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-red-600 via-red-500 to-amber-500 flex items-center justify-center text-white text-xl shadow-lg relative">
                    <i class="fa-solid fa-chalkboard-user"></i>
                    <span class="absolute -top-1 -right-1 flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-yellow-400"></span>
