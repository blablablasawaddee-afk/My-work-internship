                fieldsContainer.innerHTML = `
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่อ-นามสกุล (ภาษาไทย/ชื่อเล่น) *</label>
                        <input type="text" id="field-thaiName" required value="${item.thaiName || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="เช่น นายสมชาย (ชายน้อย)">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่อภาษาเวียดนาม (ถ้ามี)</label>
