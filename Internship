                    </div>
                    <div class="grid grid-cols-2 gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">ฟัง (Listening)</label>
                            <select id="field-listeningSkill" class="w-full px-2 py-1.5 border rounded-lg text-xs">
                                ${[1,2,3,4,5].map(n => `<option value="${n}" ${item.listeningSkill == n ? 'selected':''}>${n} ดาว</option>`).join('')}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">พูด (Speaking)</label>
                            <select id="field-speakingSkill" class="w-full px-2 py-1.5 border rounded-lg text-xs">
                                ${[1,2,3,4,5].map(n => `<option value="${n}" ${item.speakingSkill == n ? 'selected':''}>${n} ดาว</option>`).join('')}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">อ่าน (Reading)</label>
                            <select id="field-readingSkill" class="w-full px-2 py-1.5 border rounded-lg text-xs">
                                ${[1,2,3,4,5].map(n => `<option value="${n}" ${item.readingSkill == n ? 'selected':''}>${n} ดาว</option>`).join('')}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">เขียน (Writing)</label>
                            <select id="field-writingSkill" class="w-full px-2 py-1.5 border rounded-lg text-xs">
                                ${[1,2,3,4,5].map(n => `<option value="${n}" ${item.writingSkill == n ? 'selected':''}>${n} ดาว</option>`).join('')}
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">จุดเด่น</label>
                        <input type="text" id="field-strengths" value="${item.strengths || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="ข้อดีในการเรียน...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ข้อควรปรับปรุง</label>
                        <input type="text" id="field-improvements" value="${item.improvements || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="สิ่งที่ยังต้องฝึกซ้ำ...">
                    </div>
                `;
            } else if (currentTab === 'teachers') {
                const item = editId ? teachers.find(t => t.id === editId) : {};
                modalTitle.textContent = editId ? 'แก้ไขข้อมูลอาจารย์' : 'เพิ่มข้อมูลอาจารย์ใหม่';
                fieldsContainer.innerHTML = `
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่ออาจารย์ *</label>
                        <input type="text" id="field-name" required value="${item.name || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="เช่น Cô Linh">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">บทบาท / ตำแหน่ง</label>
                        <input type="text" id="field-role" value="${item.role || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="เช่น อาจารย์พี่เลี้ยง / หัวหน้าภาควิชา">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">วิชาที่รับผิดชอบ</label>
                        <input type="text" id="field-subjects" value="${item.subjects || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="เช่น การฟัง-พูดภาษาไทย 2">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ข้อมูลติดต่อ (Zalo / เบอร์โทร / Email)</label>
                        <input type="text" id="field-contact" value="${item.contact || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="Zalo: ... / Email: ...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ข้อสั่งการ / คำแนะนำสำคัญจากอาจารย์</label>
                        <textarea id="field-notes" rows="3" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="โน้ตงานหรือคำสั่งที่อาจารย์ฝากไว้...">${item.notes || ''}</textarea>
                    </div>
                `;
            } else if (currentTab === 'tasks') {
                const item = editId ? tasks.find(t => t.id === editId) : {};
                modalTitle.textContent = editId ? 'แก้ไขภารกิจ' : 'เพิ่มภารกิจใหม่';
                fieldsContainer.innerHTML = `
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่องาน / ภารกิจ *</label>
                        <input type="text" id="field-title" required value="${item.title || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="เช่น ตรวจการบ้านบทที่ 2">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">รายละเอียด</label>
                        <textarea id="field-desc" rows="2" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="รายละเอียดงานเพิ่มเติม...">${item.desc || ''}</textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">กำหนดส่ง</label>
                            <input type="date" id="field-dueDate" value="${item.dueDate || ''}" class="w-full px-3 py-2 border rounded-xl text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">ความสำคัญ</label>
                            <select id="field-priority" class="w-full px-3 py-2 border rounded-xl text-sm">
                                <option value="Low" ${item.priority === 'Low' ? 'selected':''}>ต่ำ</option>
                                <option value="Medium" ${item.priority === 'Medium' || !item.priority ? 'selected':''}>ปานกลาง</option>
                                <option value="High" ${item.priority === 'High' ? 'selected':''}>สูง</option>
                            </select>
                        </div>
                    </div>
                `;
            } else if (currentTab === 'journal') {
                const item = editId ? journal.find(j => j.id === editId) : {};
                modalTitle.textContent = editId ? 'แก้ไขบันทึก' : 'เพิ่มบันทึกใหม่';
                fieldsContainer.innerHTML = `
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">หมวดหมู่</label>
                        <select id="field-category" class="w-full px-3 py-2 border rounded-xl text-sm">
                            <option value="คำศัพท์" ${item.category === 'คำศัพท์' ? 'selected':''}>คำศัพท์ภาษาเวียดนาม</option>
                            <option value="วัฒนธรรม" ${item.category === 'วัฒนธรรม' ? 'selected':''}>เกร็ดวัฒนธรรม/การใช้ชีวิต</option>
                            <option value="ประสบการณ์" ${item.category === 'ประสบการณ์' || !item.category ? 'selected':''}>บันทึกประจำวัน/ประสบการณ์</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">หัวข้อ *</label>
                        <input type="text" id="field-title" required value="${item.title || ''}" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="ระบุหัวข้อ...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">เนื้อหา / บันทึก *</label>
                        <textarea id="field-content" required rows="5" class="w-full px-3 py-2 border rounded-xl text-sm" placeholder="พิมพ์ข้อความบันทึก...">${item.content || ''}</textarea>
                    </div>
                `;
            }

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('item-modal').classList.add('hidden');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('form-id').value;

            if (currentTab === 'students') {
                const data = {
                    id: id || 's_' + Date.now(),
                    thaiName: document.getElementById('field-thaiName').value,
                    vnName: document.getElementById('field-vnName').value,
                    classGroup: document.getElementById('field-classGroup').value,
                    listeningSkill: parseInt(document.getElementById('field-listeningSkill').value),
                    speakingSkill: parseInt(document.getElementById('field-speakingSkill').value),
                    readingSkill: parseInt(document.getElementById('field-readingSkill').value),
                    writingSkill: parseInt(document.getElementById('field-writingSkill').value),
                    strengths: document.getElementById('field-strengths').value,
                    improvements: document.getElementById('field-improvements').value,
                    createdAt: new Date().toISOString()
                };

                if (id) {
                    const idx = students.findIndex(s => s.id === id);
                    if (idx !== -1) students[idx] = data;
                } else {
                    students.unshift(data);
                }
                renderStudents();
            } else if (currentTab === 'teachers') {
                const data = {
                    id: id || 't_' + Date.now(),
                    name: document.getElementById('field-name').value,
                    role: document.getElementById('field-role').value,
                    subjects: document.getElementById('field-subjects').value,
                    contact: document.getElementById('field-contact').value,
                    notes: document.getElementById('field-notes').value,
                    createdAt: new Date().toISOString()
                };
                if (id) {
                    const idx = teachers.findIndex(t => t.id === id);
                    if (idx !== -1) teachers[idx] = data;
                } else {
                    teachers.unshift(data);
                }
                renderTeachers();
            } else if (currentTab === 'tasks') {
                const data = {
                    id: id || 'tk_' + Date.now(),
                    title: document.getElementById('field-title').value,
                    desc: document.getElementById('field-desc').value,
                    dueDate: document.getElementById('field-dueDate').value,
                    priority: document.getElementById('field-priority').value,
                    status: id ? (tasks.find(t => t.id === id)?.status || 'todo') : 'todo',
                    createdAt: new Date().toISOString()
                };
                if (id) {
                    const idx = tasks.findIndex(t => t.id === id);
                    if (idx !== -1) tasks[idx] = data;
                } else {
                    tasks.unshift(data);
                }
                renderTasks();
            } else if (currentTab === 'journal') {
                const data = {
                    id: id || 'j_' + Date.now(),
                    category: document.getElementById('field-category').value,
                    title: document.getElementById('field-title').value,
                    content: document.getElementById('field-content').value,
                    createdAt: new Date().toISOString()
                };
                if (id) {
                    const idx = journal.findIndex(j => j.id === id);
                    if (idx !== -1) journal[idx] = data;
                } else {
                    journal.unshift(data);
                }
                renderJournal();
            }

            saveData();
            closeModal();
        }

        // Helpers
        function renderStars(num) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= num) stars += '<i class="fa-solid fa-star text-amber-400"></i>';
                else stars += '<i class="fa-regular fa-star text-slate-300"></i>';
            }
            return `<div class="flex gap-0.5 text-xs">${stars}</div>`;
        }

        function getPriorityBadge(priority) {
            if (priority === 'High') return '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-red-50 text-red-600 border border-red-100">สำคัญสูง</span>';
            if (priority === 'Medium') return '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-600 border border-amber-100">ปานกลาง</span>';
            return '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">ทั่วไป</span>';
        }

        function formatDate(dStr) {
            if (!dStr) return '';
            const d = new Date(dStr);
            return d.toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
</body>
</html>
